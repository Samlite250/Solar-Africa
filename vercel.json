{
  "version": 2,
  "builds": [
    { "src": "backend/server.js", "use": "@vercel/node" },
    { "src": "frontend/**", "use": "@vercel/static" }
  ],
  "headers": [
    {
      "source": "/(.*).php",
      "headers": [
        { "key": "Content-Type", "value": "text/html" }
      ]
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/server.js" },
    { "src": "/(.*).php", "dest": "/frontend/$1.html" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
